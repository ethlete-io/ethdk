import { HttpHandler, HttpInterceptor, HttpRequest, type HttpEvent } from '@angular/common/http';
import { Injectable } from '@angular/core';
import { isBearerAuthProvider } from '@ethlete/query';
import { environment } from '@app-a/env';
import { apiClientConfig } from '@app-a/queries';
import { Observable, of } from 'rxjs';
import { map, switchMap, take } from 'rxjs/operators';

@Injectable()
export class JWTInterceptor implements HttpInterceptor {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  intercept(request: HttpRequest<any>, next: HttpHandler): Observable<HttpEvent<any>> {
    return apiClientConfig.authProvider$.pipe(
      switchMap((provider) => {
        if (provider && isBearerAuthProvider(provider)) {
          return provider.tokens$;
        }

        return of(null);
      }),
      map((tokens) => {
        if (!tokens?.token) {
          return request;
        }

        if (request.url === environment.apiBaseURL + '/status') {
          return request;
        }

        if (
          request.url.includes(environment.cms.url) ||
          request.url.includes(environment.cms.graphqlUrl)
        ) {
          return request;
        }

        if (request.url.startsWith(`${environment.apiBaseURL}/public`)) {
          return request;
        }

        return request.clone({
          setHeaders: {
            Authorization: `Bearer ${tokens.token}`,
          },
        });
      }),
      take(1),
      switchMap((r) => next.handle(r)),
    );
  }
}
