import { NgModule } from '@angular/core';
import { CommonModule } from '@angular/common';
import { StoreModule } from '@ngrx/store';
import { EffectsModule } from '@ngrx/effects';
import * as fromReducer from './state';

@NgModule({
  imports: [
    CommonModule,
    StoreModule.forFeature(fromReducer.LAYOUT_FEATURE_KEY, fromReducer.layoutReducer),
    EffectsModule.forFeature([fromReducer.LayoutEffects]),
  ],
})
export class DomainPublicStoreModule {}
