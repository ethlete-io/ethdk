import * as Actions from './event.actions';
import { Action } from '@ngrx/store';
import { createReducerSlice } from '@tomtomb/ngrx-toolkit';

export const EVENT_FEATURE_KEY = 'event';

export type State = typeof initialState;

export interface EventPartialState {
  readonly [EVENT_FEATURE_KEY]: State;
}

export const { reducerSlice, reducerAdapters, initialState } = createReducerSlice({
  actions: Actions.EVENT_ACTIONS,
  key: EVENT_FEATURE_KEY,
  initialStateExtra: {},
});

export function reducer(state: State | undefined, action: Action) {
  return reducerSlice(state, action);
}
