{
  "name": "cli-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cli-core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:noop"
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/cli-core"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/cli-core"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/cli-core/tsconfig.spec.json --noEmit && tsc -p libs/cli-core/tsconfig.lib.json --noEmit"
      }
    }
  }
}
