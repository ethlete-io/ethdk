// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StandingsComponent without the optional extras > renders the same DOM as before the extras existed 1`] = `"<et-standings highlightedrowid="neo" class="et-standings" data-has-zones=""><div class="et-standings-content"><table class="et-standings-table"><caption class="et-visually-hidden et-standings-caption"> Standings </caption><thead><tr class="et-standings-head-row"><th data-column="position" scope="col" class="et-standings-cell" abbr="Position"> # </th><th data-column="participant" scope="col" class="et-standings-cell">Team</th><th data-column="detail" scope="col" class="et-standings-cell" abbr="Played"> P </th><th data-column="detail" scope="col" class="et-standings-cell" abbr="Wins"> W </th><th data-column="detail" scope="col" class="et-standings-cell" abbr="Draws"> D </th><th data-column="detail" scope="col" class="et-standings-cell" abbr="Losses"> L </th><th data-column="detail" scope="col" class="et-standings-cell" abbr="Difference"> Diff </th><th data-column="points" scope="col" class="et-standings-cell" abbr="Points"> Pts </th><th data-column="form" scope="col" class="et-standings-cell" abbr="Recent form, oldest first"> Form </th></tr></thead><tbody><tr class="et-standings-row et-color--brand" data-zone=""><th data-column="position" scope="row" class="et-standings-cell"> 1 <span class="et-visually-hidden et-standings-zone-note"> Advances</span></th><td data-column="participant" class="et-standings-cell"><et-match-participant class="et-match-participant et-standings-participant et-focus-ring"><span class="et-match-participant-emblem"><span aria-hidden="true" class="et-match-participant-emblem-mark" data-mark="F"></span></span><span class="et-match-participant-names"><span class="et-match-participant-name"> FC Berlin </span></span></et-match-participant></td><td data-column="detail" class="et-standings-cell">10</td><td data-column="detail" class="et-standings-cell">8</td><td data-column="detail" class="et-standings-cell">1</td><td data-column="detail" class="et-standings-cell">1</td><td data-column="detail" class="et-standings-cell">+18</td><td data-column="points" class="et-standings-cell">25</td><td data-column="form" class="et-standings-cell"><span class="et-standings-form"><span aria-hidden="true" class="et-standings-form-result" data-result="win">W</span><span class="et-visually-hidden et-standings-form-note"> Win</span><span aria-hidden="true" class="et-standings-form-result" data-result="tie">D</span><span class="et-visually-hidden et-standings-form-note"> Draw</span><span aria-hidden="true" class="et-standings-form-result" data-result="loss">L</span><span class="et-visually-hidden et-standings-form-note"> Loss</span></span></td></tr><tr class="et-standings-row et-color--inherited" data-highlighted="" aria-current="true"><th data-column="position" scope="row" class="et-standings-cell"> 2 <span class="et-visually-hidden et-standings-zone-note"> Your team</span></th><td data-column="participant" class="et-standings-cell"><et-match-participant class="et-match-participant et-standings-participant et-focus-ring"><span class="et-match-participant-emblem"><span aria-hidden="true" class="et-match-participant-emblem-mark" data-mark="N"></span></span><span class="et-match-participant-names"><span class="et-match-participant-name"> Neon Esports </span></span></et-match-participant></td><td data-column="detail" class="et-standings-cell">10</td><td data-column="detail" class="et-standings-cell">8</td><td data-column="detail" class="et-standings-cell">1</td><td data-column="detail" class="et-standings-cell">1</td><td data-column="detail" class="et-standings-cell">+18</td><td data-column="points" class="et-standings-cell">23</td><td data-column="form" class="et-standings-cell"></td></tr><tr class="et-standings-row et-color--inherited"><th data-column="position" scope="row" class="et-standings-cell"> 3 </th><td data-column="participant" class="et-standings-cell"><et-match-participant class="et-match-participant et-standings-participant et-focus-ring"><span class="et-match-participant-emblem"><span aria-hidden="true" class="et-match-participant-emblem-mark" data-mark="R"></span></span><span class="et-match-participant-names"><span class="et-match-participant-name"> Rote Löwen </span></span></et-match-participant></td><td data-column="detail" class="et-standings-cell">10</td><td data-column="detail" class="et-standings-cell">8</td><td data-column="detail" class="et-standings-cell">1</td><td data-column="detail" class="et-standings-cell">1</td><td data-column="detail" class="et-standings-cell">+18</td><td data-column="points" class="et-standings-cell">17</td><td data-column="form" class="et-standings-cell"></td></tr></tbody></table><ul class="et-standings-legend" aria-label="What the highlighted positions mean"><li class="et-standings-legend-item"><span aria-hidden="true" class="et-standings-legend-swatch et-color--brand"></span> Advances </li></ul></div></et-standings>"`;
