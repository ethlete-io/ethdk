{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/components",
  "assets": [
    "CHANGELOG.md",
    "migrations.json",
    "generators/generators.json",
    {
      "glob": "**/*.js",
      "input": "generators/dist",
      "output": "./generators"
    },
    {
      "glob": "**/schema.json",
      "input": "generators",
      "output": "./generators"
    },
    {
      "glob": "**/*.ts",
      "input": "design",
      "output": "./design"
    },
    {
      "glob": "**/*",
      "input": ".design-base",
      "output": "./design"
    },
    {
      "glob": "**/*.css",
      "input": "src/lib",
      "output": "./src/lib"
    },
    {
      "glob": "{icon-definition,*-icon,*-icons}.ts",
      "input": "src/lib/icon/headless",
      "output": "./src/lib/icon/headless"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  },
  "allowedNonPeerDependencies": ["@ethlete/bracket"]
}
