{
  "name": "components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/components/src",
  "prefix": "et",
  "tags": ["scope:components"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build", "build-generators", "generate-version", "stage-design-base"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/.ethlete/design/config.json",
        "{workspaceRoot}/.ethlete/design/sdk/**/*"
      ],
      "outputs": ["{workspaceRoot}/dist/libs/components"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/components/ng-package.json",
        "tsConfig": "libs/components/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/components/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/components"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/components"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/components/tsconfig.spec.json --noEmit && ngc -p libs/components/tsconfig.narrowed-themes.json"
      }
    },
    "build-generators": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["rm -rf libs/components/generators/dist", "tsc -p libs/components/generators/tsconfig.json"],
        "parallel": false
      }
    },
    "stage-design-base": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/.ethlete/design/config.json",
        "{workspaceRoot}/.ethlete/design/sdk/**/*",
        "{workspaceRoot}/tools/scripts/stage-design-base.mjs"
      ],
      "outputs": ["{projectRoot}/.design-base"],
      "options": {
        "command": "node tools/scripts/stage-design-base.mjs sdk libs/components/.design-base"
      }
    },
    "generate-version": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["node tools/scripts/generate-version.js components"]
      }
    }
  }
}
