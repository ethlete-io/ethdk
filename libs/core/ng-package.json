{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/core",
  "assets": [
    "CHANGELOG.md",
    "migrations.json",
    "generators/generators.json",
    {
      "glob": "**/*.js",
      "input": "generators/dist/generators",
      "output": "./generators"
    },
    {
      "glob": "**/*.js",
      "input": "generators/dist/design",
      "output": "./design"
    },
    {
      "glob": "**/schema.json",
      "input": "generators",
      "output": "./generators"
    },
    {
      "glob": "**/*.md",
      "input": "migrations",
      "output": "./migrations"
    },
    {
      "glob": "**/*.ts",
      "input": "design",
      "output": "./design"
    },
    {
      "glob": "**/*.css",
      "input": "src/lib",
      "output": "./src/lib"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  }
}
