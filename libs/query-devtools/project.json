{
  "name": "query-devtools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/query-devtools/src",
  "prefix": "et",
  "tags": ["scope:query-devtools"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build", "generate-version"],
      "outputs": ["{workspaceRoot}/dist/libs/query-devtools"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/query-devtools/ng-package.json",
        "tsConfig": "libs/query-devtools/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/query-devtools/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/query-devtools"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/query-devtools"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "generate-version": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["node tools/scripts/generate-version.js query-devtools"]
      }
    }
  }
}
