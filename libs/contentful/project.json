{
  "name": "contentful",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/contentful/src",
  "prefix": "ethlete",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build", "build-generators"],
      "outputs": ["{workspaceRoot}/dist/libs/contentful"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/contentful/ng-package.json",
        "tsConfig": "libs/contentful/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/contentful/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/contentful"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/contentful"
      }
    },
    "build-generators": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["rm -rf libs/contentful/generators/dist", "tsc -p libs/contentful/generators/tsconfig.json"]
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
