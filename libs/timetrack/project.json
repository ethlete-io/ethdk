{
  "name": "timetrack",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/timetrack/src",
  "prefix": "ethlete",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/timetrack"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/timetrack/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/timetrack/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/timetrack/tsconfig.lib.json"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/timetrack/tsconfig.spec.json --noEmit && tsc -p libs/timetrack/tsconfig.lib.json --noEmit"
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "esbuild libs/timetrack/testing/row-build.bench.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.base.json --log-level=warning --outfile=tmp/timetrack-bench/row-build.mjs && node {args.prof} tmp/timetrack-bench/row-build.mjs {args.events} {args.runs}",
        "args": "--events=synthetic --runs=5 --prof="
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/timetrack"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/timetrack"
      }
    }
  }
}
