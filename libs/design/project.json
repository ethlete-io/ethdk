{
  "name": "design",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        {
          "projects": ["cli"],
          "target": "build"
        }
      ]
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/design"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/design"
      }
    },
    "test-perf": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node -e \"require('node:fs').rmSync('tmp/perf',{recursive:true,force:true})\" && vitest run --config libs/design/vitest.perf.config.mts"
      }
    },
    "test-dist": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config libs/design/vitest.dist.config.mts"
      }
    },
    "proof": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config libs/design/vitest.proof.config.mts"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/design/tsconfig.spec.json --noEmit && tsc -p libs/design/tsconfig.lib.json --noEmit"
      }
    }
  }
}
