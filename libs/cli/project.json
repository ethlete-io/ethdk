{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cli/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["design"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": false,
      "options": {
        "command": "node libs/cli/scripts/move-into-place.mts tmp/cli-build dist/libs/cli && node libs/cli/scripts/write-build-info.mts dist/libs/cli"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "input": "production",
          "projects": ["design"]
        },
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "outputs": ["{workspaceRoot}/tmp/cli-build"],
      "options": {
        "command": "node libs/cli/scripts/compile.mts tmp/cli-build dist/libs/cli"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/scripts/publish.mjs cli {args.ver} {args.tag}"
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/cli"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/cli"
      }
    },
    "test-perf": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node -e \"require('node:fs').rmSync('tmp/perf',{recursive:true,force:true})\" && vitest run --config libs/design/vitest.perf.config.mts"
      }
    },
    "test-dist": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config libs/design/vitest.dist.config.mts"
      }
    },
    "proof": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config libs/design/vitest.proof.config.mts"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/cli/tsconfig.spec.json --noEmit && tsc -p libs/cli/tsconfig.lib.json --noEmit"
      }
    }
  }
}
