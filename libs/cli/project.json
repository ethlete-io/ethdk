{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cli/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": false,
      "options": {
        "command": "node libs/cli/scripts/move-into-place.mts tmp/cli-build dist/libs/cli"
      }
    },
    "compile": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "tmp/cli-build",
        "main": "libs/cli/src/index.ts",
        "tsConfig": "libs/cli/tsconfig.lib.json",
        "assets": [
          "libs/cli/*.md",
          { "input": "libs/cli/design", "glob": "**/*", "output": "design", "ignore": ["tsconfig.json"] }
        ]
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/scripts/publish.mjs cli {args.ver} {args.tag}"
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/cli"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/cli"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/cli/tsconfig.spec.json --noEmit"
      }
    }
  }
}
