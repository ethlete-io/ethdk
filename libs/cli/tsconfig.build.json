{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "rootDir": ".."
  },
  "include": ["src/**/*.ts", "../cli-core/src/lib/**/*.ts", "../design/src/lib/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.fixtures.ts",
    "../cli-core/src/**/*.spec.ts",
    "../cli-core/src/**/*.test.ts",
    "../cli-core/src/**/*.fixtures.ts",
    "../design/src/**/*.spec.ts",
    "../design/src/**/*.test.ts",
    "../design/src/**/*.fixtures.ts"
  ]
}
