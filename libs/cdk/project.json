{
  "name": "cdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/cdk/src",
  "prefix": "ethlete",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build", "build-generators"],
      "outputs": ["{workspaceRoot}/dist/libs/cdk"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/cdk/ng-package.json",
        "tsConfig": "libs/cdk/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/cdk/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/cdk"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/cdk"
      },
      "inputs": ["default", "^production", "{workspaceRoot}/libs/components/src/**/*.css"]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/cdk/tsconfig.spec.json --noEmit && ngc -p libs/cdk/tsconfig.lib.json --noEmit"
      }
    },
    "build-generators": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node -e \"require('node:fs').rmSync('libs/cdk/generators/dist',{recursive:true,force:true})\"",
          "tsc -p libs/cdk/generators/tsconfig.json"
        ],
        "parallel": false
      }
    }
  }
}
