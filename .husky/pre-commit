#!/usr/bin/env sh
# Holds staged changeset notes to the bar in the `changeset` skill (one to two sentences, 40 words).
# Only staged files are passed, so a commit is never blocked by an over-long note someone else left
# behind - and a commit touching no changeset skips the check entirely.

staged=$(git diff --cached --name-only --diff-filter=ACM -- '.changeset/*.md')

if [ -n "$staged" ]; then
  # Word-split on purpose - changeset filenames never contain spaces.
  # shellcheck disable=SC2086
  node ./tools/scripts/lint-changesets.js $staged
fi

# Catches an @property initial-value the browser drops (a relative unit is not computationally
# independent), which leaves the token unregistered and every use site silently unset.
styles=$(git diff --cached --name-only --diff-filter=ACM -- '*.css' '*.scss' '*.ts' '*.html')

if [ -n "$styles" ]; then
  # shellcheck disable=SC2086
  node ./tools/scripts/lint-css-properties.js $styles
fi

# vitest resolves relative paths against the Studio root, not the repo root, so pass absolute ones.
studio=$(git diff --cached --name-only --diff-filter=ACM -- 'apps/ethlete-studio/*' | sed "s|^|$PWD/|")

if [ -n "$studio" ]; then
  # shellcheck disable=SC2086
  npx vitest related --run --passWithNoTests --reporter=default --config apps/ethlete-studio/vite.config.mts $studio || {
    echo 'pre-commit: a Studio spec related to the staged files fails (FAIL lines above name it). It runs on the working tree, so the red may be uncommitted work of another session in this checkout.' >&2
    exit 1
  }
fi
