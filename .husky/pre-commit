#!/usr/bin/env sh
# Without -e only the last command decides the exit code, so a failed check above it lets the commit through.
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1
# Holds staged changeset notes to the bar in the `changeset` skill (one to two sentences, 40 words).
# Only staged files are passed, so a commit is never blocked by an over-long note someone else left
# behind - and a commit touching no changeset skips the check entirely.

staged=$(git diff --cached --name-only --diff-filter=ACM -- '.changeset/*.md')

if [ -n "$staged" ]; then
  # Word-split on purpose - changeset filenames never contain spaces.
  # shellcheck disable=SC2086
  node ./tools/scripts/lint-changesets.js $staged
fi

# Catches an @property initial-value the browser drops (a relative unit is not computationally
# independent), which leaves the token unregistered and every use site silently unset.
styles=$(git diff --cached --name-only --diff-filter=ACM -- '*.css' '*.scss' '*.ts' '*.html')

if [ -n "$styles" ]; then
  # shellcheck disable=SC2086
  node ./tools/scripts/lint-css-properties.js $styles
fi

# Warns, never blocks, when a staged path is outside the slice paths of the brief: env ETHLETE_SLICE_PATHS or
# the file `slice-paths` in the worktree's git dir. One git diff (about 0.05 s); silent when none are declared.
node ./tools/scripts/check-slice-paths.mjs

# A closed STATUS row whose ADR still says `open:` fails here instead of at push (about 0.7 s).
adr_files=$(git diff --cached --name-only --diff-filter=ACM -- 'plans/ethlete-studio/STATUS.md' 'apps/ethlete-studio/docs/adr/*.md')

if [ -n "$adr_files" ]; then
  node ./tools/scripts/check-studio-adrs.mjs --summary >/dev/null
fi

# A commit that cuts finding head or as-built lines from the design plan must archive them, and finding numbers
# must increase (about 0.1 s).
if git diff --cached --name-only --diff-filter=M -- 'plans/ethlete-studio/design-to-code.md' | grep -q .; then
  node ./tools/scripts/check-plan-findings.mjs
fi

# Prettier check of every staged Markdown blob; size budget and cell cap of the two big plan files.
plan_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')

if [ -n "$plan_files" ]; then
  # shellcheck disable=SC2086
  node ./tools/scripts/check-staged-plans.mjs $plan_files
fi

# A staged studio spec or label file fails here when a spec still asserts a label text removed since the upstream.
label_files=$(git diff --cached --name-only --diff-filter=ACM -- 'apps/ethlete-studio/*.spec.ts' 'apps/ethlete-studio/src/app/i18n/studio-labels.ts')

if [ -n "$label_files" ]; then
  node ./tools/scripts/studio-label-specs.mjs --staged
fi

# Lint errors fail here instead of in CI: eslint on the staged files only, with the config of the lib they sit in.
lint_files=$(git diff --cached --name-only --diff-filter=ACM -- 'libs/*.ts' 'apps/*.ts' 'tools/*.mjs' 'tools/*.js' 'libs/*.mjs' 'libs/*.js')

if [ -n "$lint_files" ]; then
  # shellcheck disable=SC2086
  node ./tools/scripts/lint-staged-files.mjs $lint_files
fi

# A staged .ethlete file fails here when eslint finds more than the committed lint-baseline.json above it allows.
design_files=$(git diff --cached --name-only --diff-filter=ACM -- '.ethlete/*.ts')

if [ -n "$design_files" ]; then
  # shellcheck disable=SC2086
  node ./tools/scripts/lint-staged-design.mjs $design_files
fi

# Refuses a ✅ row, an Erledigt section and a Stand older than 3 days in the staged STATUS.md blob (about 0.05 s).
if git diff --cached --name-only --diff-filter=ACM -- 'plans/ethlete-studio/STATUS.md' | grep -q .; then
  git show :plans/ethlete-studio/STATUS.md | node ./tools/scripts/check-studio-status.mjs -
fi

# A staged path under a data glob of tools/scripts/data-spec-map.json runs the specs that read that data (finding 799);
# a commit touching none of them skips it. Fails the commit on a red spec.
data_files=$(git diff --cached --name-only --diff-filter=ACMR -- '.ethlete' '.github/workflows')

if [ -n "$data_files" ]; then
  # shellcheck disable=SC2086
  node ./tools/scripts/staged-data-specs.mjs $data_files
fi

# A staged file that names a real person fails here with the pre-push message; the staged blob is read, not the working tree.
name_files=$(git diff --cached --name-only --diff-filter=ACM -- 'libs' 'apps' '.ethlete/design')

if [ -n "$name_files" ]; then
  node ./tools/scripts/check-person-names.mjs --staged
fi
