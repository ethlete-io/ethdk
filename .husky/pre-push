#!/usr/bin/env sh
# The format check reads committed blobs, so other sessions' uncommitted edits never block a push.
set -e
# The docs build runs ~8 min with the push connection already open; GitHub drops it and git push exits 141 (SIGPIPE) after
# a green hook. The stamp lets the retry of the same sha skip the build.
cd "$(git rev-parse --show-toplevel)"

export NX_NO_CLOUD=true
export NX_DAEMON=false

zero=0000000000000000000000000000000000000000
failed=0
docs_stamp=$(git rev-parse --git-path pre-push-docs-built)

while read -r _ local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
  else
    base=$(git merge-base "$local_sha" origin/main)
    next_base=$(git merge-base "$local_sha" origin/next 2>/dev/null || true)
    if [ -n "$next_base" ] && git merge-base --is-ancestor "$base" "$next_base"; then
      base=$next_base
    fi
  fi

  export NX_BASE="$base" NX_HEAD="$local_sha"

  node .husky/format-check-committed.mjs "$base" "$local_sha" || failed=1

  yarn commitlint --from "$base" --to "$local_sha" || failed=1

  node tools/scripts/pre-push-checks.mjs "$base" "$local_sha" || failed=1

  if [ "$remote_ref" = refs/heads/next ]; then
    node tools/scripts/push-suite.mjs --check "$base" "$local_sha" || failed=1
    node tools/scripts/push-slot.mjs check "$local_sha" || failed=1
  fi

  if git diff --name-only "$base" "$local_sha" | grep -q '^apps/docs/' && [ "$(cat "$docs_stamp" 2>/dev/null)" != "$local_sha" ]; then
    if yarn vitepress build apps/docs; then echo "$local_sha" > "$docs_stamp"; else failed=1; fi
  fi
done

exit "$failed"
