#!/usr/bin/env sh
# The format check reads committed blobs, so other sessions' uncommitted edits never block a push.
set -e
cd "$(git rev-parse --show-toplevel)"

export NX_NO_CLOUD=true
export NX_DAEMON=false

zero=0000000000000000000000000000000000000000
failed=0

while read -r _ local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
  else
    base=$(git merge-base "$local_sha" origin/main)
  fi

  export NX_BASE="$base" NX_HEAD="$local_sha"

  node .husky/format-check-committed.mjs "$base" "$local_sha" || failed=1

  for check in lint:changesets versions:check lint:size lint:cli-related-map lint:migration-entries lint:studio-label-specs lint:studio-adrs docs:error-codes:check sdk:tokens:check; do
    out=$(yarn "$check" 2>&1) || { echo "pre-push: $check failed:"; echo "$out"; failed=1; }
  done

  node tools/scripts/lib-build-gate.mjs "$base" "$local_sha" || failed=1
  # A held push of next sends each slice to a draft PR whose CI runs this gate (ADR 0216); blocking slice/* here would close that path.
  case "$remote_ref" in
    refs/heads/slice/*) echo "pre-push: design gate skipped for $remote_ref, the draft PR CI runs it (ADR 0216)" ;;
    *) node tools/scripts/design-rules-gate.mjs "$base" "$local_sha" || failed=1 ;;
  esac

  if git diff --name-only "$base" "$local_sha" | grep -q '^apps/docs/'; then
    yarn vitepress build apps/docs || failed=1
  fi
done

exit "$failed"
