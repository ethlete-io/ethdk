{
  "name": "docs-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs-mcp/src",
  "tags": ["type:app", "scope:docs"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/docs-mcp"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "npx tsc -p apps/docs-mcp/tsconfig.app.json",
          "cp apps/docs-mcp/functions.package.json dist/apps/docs-mcp/package.json"
        ],
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx --yes firebase-tools deploy --only functions:{args.fn} --project ethlete-sdk --non-interactive"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
