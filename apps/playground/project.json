{
  "name": "playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/playground/src",
  "prefix": "ethlete",
  "tags": [],
  "implicitDependencies": ["components"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "browser": "apps/playground/src/main.ts",
        "outputPath": "dist/apps/playground",
        "index": "apps/playground/src/index.html",
        "tsConfig": "apps/playground/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/playground/src/favicon.ico", "apps/playground/src/assets"],
        "styles": ["apps/playground/src/styles.scss", "libs/cdk/src/lib/styles/easing.css"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "24kb",
              "maximumError": "32kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "playground:build:production"
        },
        "development": {
          "buildTarget": "playground:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "playground:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "apps/playground/.storybook",
        "browserTarget": "playground:build-storybook",
        "compodoc": false,
        "styles": ["libs/cdk/src/lib/styles/index.css", "apps/playground/src/styles/storybook.css"],
        "open": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        },
        "network": {
          "host": "0.0.0.0"
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/playground",
        "configDir": "apps/playground/.storybook",
        "browserTarget": "playground:build-storybook",
        "compodoc": false,
        "styles": ["libs/cdk/src/lib/styles/index.css", "apps/playground/src/styles/storybook.css"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
