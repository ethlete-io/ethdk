{
  "name": "storybook-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storybook-e2e/src",
  "tags": ["type:e2e", "scope:components"],
  "implicitDependencies": ["storybook"],
  "targets": {
    "e2e": {
      "dependsOn": [
        {
          "projects": ["storybook"],
          "target": "build-storybook"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/storybook-e2e/tsconfig.json --noEmit"
      }
    }
  }
}
