{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Ethlete Studio main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-agent-cancel",
    "allow-agent-list",
    "allow-agent-run",
    "allow-workspace-check",
    "allow-workspace-diff",
    "allow-workspace-root",
    "allow-workspace-status"
  ]
}
