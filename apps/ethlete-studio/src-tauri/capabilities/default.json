{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Ethlete Studio main window.",
  "windows": ["main", "main-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-agent-cancel",
    "allow-agent-list",
    "allow-agent-run",
    "allow-design-project",
    "allow-design-roots",
    "allow-design-roots-add",
    "allow-design-roots-forget",
    "allow-design-roots-search",
    "allow-design-scan",
    "allow-design-status-watch",
    "allow-design-server-start",
    "allow-design-server-restart",
    "allow-design-server-state",
    "allow-design-server-stop",
    "allow-update-install",
    "allow-update-ready",
    "allow-workspace-check",
    "allow-workspace-diff",
    "allow-workspace-root",
    "allow-workspace-status"
  ]
}
