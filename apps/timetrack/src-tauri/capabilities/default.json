{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app window may reach. Every provider call goes through this app's own commands, so no HTTP or shell plugin permission belongs here. The window permissions are what the titlebar the app draws itself needs, since turning decorations off leaves no other way to move or close the window. The allow-* entries name this app's own commands: the list is every command lib.rs registers, and a command missing from it is refused before the handler runs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-agent-log-lines",
    "allow-agent-logs",
    "allow-agent-reply",
    "allow-agent-session-cursors",
    "allow-agent-status",
    "allow-app-settings",
    "allow-call-events",
    "allow-call-source-status",
    "allow-collection-set-paused",
    "allow-collection-state",
    "allow-compacted-through",
    "allow-day-nudge-record",
    "allow-day-review-edits",
    "allow-events-append",
    "allow-events-between",
    "allow-events-by-source",
    "allow-events-delete-before",
    "allow-events-oldest-at",
    "allow-events-set-titles",
    "allow-events-titles-after",
    "allow-git-changes",
    "allow-git-repos",
    "allow-http-request",
    "allow-ingest-events",
    "allow-ingest-status",
    "allow-ledger-entries-for-day",
    "allow-ledger-remove",
    "allow-ledger-upsert",
    "allow-lock-state",
    "allow-lock-window",
    "allow-notify",
    "allow-oauth-authorize",
    "allow-reporter-vsix-path",
    "allow-run-process",
    "allow-secret-delete",
    "allow-secret-has",
    "allow-secret-read",
    "allow-secret-write",
    "allow-set-app-settings",
    "allow-set-compacted-through",
    "allow-set-day-nudge-record",
    "allow-set-day-review-edits",
    "allow-set-tempo-coverage",
    "allow-tempo-coverage-for-day",
    "allow-timer-label",
    "allow-timer-running",
    "allow-timer-runs-between",
    "allow-timer-start",
    "allow-timer-stop",
    "allow-tray-set-readout",
    "allow-unlock-window",
    "allow-widget-close",
    "allow-widget-is-open",
    "allow-widget-open",
    "allow-widget-reveal-app",
    "allow-window-capabilities",
    "allow-window-events",
    "allow-window-request-accessibility",
    "allow-window-source-status"
  ]
}
