{
  "port": 4402,
  "defaultCall": "timetrack/kerbe/03-narrow-lane",
  "render": {
    "packages": {
      "@ethlete/*": "dist/libs/*"
    }
  },
  "projects": {
    "timetrack": {
      "styles": ["apps/timetrack/src/styles.css"],
      "head": ".ethlete/design/calls/timetrack/head.html"
    },
    "sandbox": {
      "styles": ["apps/timetrack/src/styles.css"],
      "head": ".ethlete/design/calls/timetrack/head.html"
    },
    "studio": {
      "styles": ["apps/ethlete-studio/src/styles.css"]
    },
    "design-tool": {
      "styles": ["apps/ethlete-studio/src/styles.css"]
    },
    "components": {
      "providers": ".ethlete/design/calls/components/providers.ts",
      "themes": {
        "surface": ["light", "dark"],
        "color": ["brand", "danger", "warning"]
      }
    }
  },
  "products": {
    "studio-lab": {
      "schemes": ["dark"],
      "styles": ["apps/ethlete-studio/src/styles.css", ".ethlete/design/studio-lab/foundations/tokens/tokens.css"],
      "presets": {
        "phone": {
          "width": 390,
          "height": 844
        },
        "desktop": {
          "width": 1440,
          "height": 900
        }
      }
    },
    "sdk": {
      "tokens": ["foundations/colors"],
      "presets": {
        "phone": {
          "width": 390,
          "height": 844
        },
        "desktop": {
          "width": 1440,
          "height": 900
        }
      },
      "generatedFiles": ["foundations/colors/colors.css"],
      "harness": {
        "app": "apps/docs-examples",
        "map": "apps/docs-examples/src/app/design-harness/design-harness-parts.ts"
      }
    },
    "studio": {
      "schemes": ["dark"],
      "styles": [".ethlete/design/studio/styles.css"],
      "generated": [
        {
          "part": "foundations/colors",
          "command": ["node", "tools/scripts/generate-studio-themes.mjs"],
          "stylesheets": [
            "apps/ethlete-studio/src/styles/themes.css",
            "apps/ethlete-studio/src/styles/surface-themes.css"
          ]
        }
      ],
      "base": ".ethlete/design/sdk",
      "harness": {
        "app": "apps/ethlete-studio",
        "map": "apps/ethlete-studio/src/app/design-harness/design-harness-parts.ts",
        "shared": ["apps/ethlete-studio/src/app/i18n/**"]
      },
      "tokens": ["foundations/colors", "foundations/type", "foundations/spacing"],
      "presets": {
        "desktop": {
          "width": 1440,
          "height": 900
        }
      },
      "deniedClasses": [
        {
          "pattern": "^(bg|text|border|ring|divide|outline)-surface(-(raised|overlay|hover|pressed|sunken))?$",
          "fix": "Use the et-surface tokens of the scope (bg-et-surface-bg, text-et-surface-text, border-et-surface-border); set data-et-surface or a surface scope class on a raised or floating area; hover and pressed mix --et-surface-interaction-solid"
        },
        {
          "pattern": "^var\\(--surface(-(raised|overlay|hover|pressed|sunken|dark-elevated|dark-elevated-2))?\\)$",
          "fix": "Use the et-surface tokens of the scope (bg-et-surface-bg, text-et-surface-text, border-et-surface-border); set data-et-surface or a surface scope class on a raised or floating area; hover and pressed mix --et-surface-interaction-solid"
        },
        {
          "pattern": "^(bg|text|border|ring|divide|outline|fill|stroke)-accent(-|$)",
          "fix": "Use the SDK colour theming: --et-theme-color-* tokens under a colour theme scope (injectSemanticColorTheme types), not the Studio accent, warning or danger vars"
        },
        {
          "pattern": "^var\\(--(accent|warning|danger)(-|\\))",
          "fix": "Use the SDK colour theming: --et-theme-color-* tokens under a colour theme scope (injectSemanticColorTheme types), not the Studio accent, warning or danger vars"
        }
      ]
    }
  }
}
