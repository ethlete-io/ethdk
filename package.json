{
  "name": "@ethlete/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "libs/*",
    "apps/ethlete-studio",
    "apps/timetrack",
    "tools/changesets-action"
  ],
  "scripts": {
    "agents:check": "nx build agent-rules && node dist/libs/agent-rules/src/index.js check",
    "agents:sessions": "node .agents/skills/ethlete-agent-sessions/agent-sessions.mjs",
    "agents:sync": "nx build agent-rules && node dist/libs/agent-rules/src/index.js sync",
    "amend": "git commit --amend --no-edit",
    "changeset:prerelease": "node ./tools/scripts/enter-prerelease-mode.js && yarn changeset version && yarn versions:sync && yarn install --mode=update-lockfile",
    "changeset:release": "node ./tools/scripts/exit-prerelease-mode.js && yarn changeset version && yarn versions:sync && yarn install --mode=update-lockfile",
    "commit": "yarn dlx @commitlint/prompt-cli",
    "components:export-coverage": "node ./tools/export-coverage/check.mjs components",
    "core:export-coverage": "node ./tools/export-coverage/check.mjs core",
    "design": "nx build cli && node dist/libs/cli/src/index.js design",
    "design:check": "nx build cli && node dist/libs/cli/src/index.js design check",
    "docs": "nx serve docs",
    "docs:error-codes:check": "node ./tools/scripts/check-error-codes-docs.mjs",
    "e2e:affected": "node apps/storybook-e2e/affected.mjs origin/next --run",
    "lint:changesets": "node ./tools/scripts/lint-changesets.js && node ./tools/scripts/check-changeset-coverage.js",
    "lint:size": "node ./tools/scripts/check-size-budget.mjs",
    "lint:css-properties": "node ./tools/scripts/lint-css-properties.js",
    "prepare": "husky",
    "prepare:release": "node ./tools/scripts/prepare-release.js",
    "query:export-coverage": "node ./tools/export-coverage/check.mjs query",
    "release": "yarn prepare:release && yarn changeset publish",
    "release:smoke": "node ./tools/release-smoke/smoke.mjs",
    "sdk:tokens": "node tools/scripts/generate-sdk-tokens.mjs",
    "sdk:tokens:check": "node tools/scripts/generate-sdk-tokens.mjs --check",
    "sessions": "node .agents/skills/ethlete-agent-sessions/agent-sessions.mjs",
    "storybook": "nx run storybook:storybook:network",
    "studio": "nx tauri:dev ethlete-studio",
    "studio:themes": "node tools/scripts/generate-studio-themes.mjs",
    "studio:verify": "node tools/scripts/verify-studio-headless.mjs",
    "timetrack": "nx tauri:dev timetrack-app",
    "timetrack:build": "nx tauri:build timetrack-app",
    "update-nx": "rm -f migrations.json && yarn dlx nx migrate latest && yarn dlx nx migrate --run-migrations --if-exists",
    "versions:check": "node ./tools/scripts/generate-version.js --all --check && node ./tools/scripts/sync-tauri-version.js --check && node ./tools/scripts/sync-mod-version.js --check && node ./tools/scripts/check-peer-ranges.js",
    "versions:sync": "node ./tools/scripts/generate-version.js --all && node ./tools/scripts/sync-tauri-version.js && node ./tools/scripts/sync-mod-version.js"
  },
  "resolutions": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "webpack": "5.101.2"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@changesets/cli": "3.0.3",
    "@date-fns/tz": "1.5.0",
    "@floating-ui/dom": "1.8.0",
    "@tauri-apps/api": "2.12.4",
    "date-fns": "4.4.0",
    "rxjs": "7.8.2",
    "socket.io-client": "4.8.4",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "2.9.2",
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@analogjs/vitest-angular": "2.9.2",
    "@angular-devkit/core": "22.2.5",
    "@angular-devkit/schematics": "22.2.5",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@contentful/rich-text-types": "17.2.7",
    "@eslint/js": "10.0.1",
    "@nx/angular": "24.0.2",
    "@nx/devkit": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/playwright": "24.0.2",
    "@nx/storybook": "24.0.2",
    "@nx/vite": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@nx/workspace": "24.0.2",
    "@oxc-project/runtime": "0.156.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "22.2.5",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/angular": "10.6.5",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/utils": "8.72.1",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@vscode/vsce": "^4.1.0",
    "ajv": "8.20.0",
    "angular-eslint": "22.6.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "fake-indexeddb": "^6.2.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "jsonc-eslint-parser": "3.3.0",
    "ng-packagr": "22.2.5",
    "nx": "24.0.2",
    "postcss": "8.5.32",
    "postcss-import": "17.0.1",
    "postcss-preset-env": "11.6.1",
    "postcss-url": "10.1.4",
    "prettier": "3.9.10",
    "prettier-plugin-organize-attributes": "1.0.0",
    "prettier-plugin-packagejson": "3.0.3",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "ts-morph": "28.0.0",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.14.0",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.18.0"
}
