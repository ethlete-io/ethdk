{
  "name": "@ethlete/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "libs/*",
    "apps/ethlete-studio",
    "apps/timetrack",
    "tools/changesets-action"
  ],
  "scripts": {
    "agents:check": "nx build agent-rules && node dist/libs/agent-rules/src/index.js check",
    "agents:sync": "nx build agent-rules && node dist/libs/agent-rules/src/index.js sync",
    "amend": "git commit --amend --no-edit",
    "changeset:prerelease": "node ./tools/scripts/enter-prerelease-mode.js && yarn changeset version && yarn versions:sync && yarn install --mode=update-lockfile",
    "changeset:release": "node ./tools/scripts/exit-prerelease-mode.js && yarn changeset version && yarn versions:sync && yarn install --mode=update-lockfile",
    "commit": "yarn dlx @commitlint/prompt-cli",
    "design": "nx build cli && node dist/libs/cli/src/index.js design",
    "design:check": "nx build cli && node dist/libs/cli/src/index.js design check",
    "docs": "nx serve docs",
    "lint:changesets": "node ./tools/scripts/lint-changesets.js",
    "lint:css-properties": "node ./tools/scripts/lint-css-properties.js",
    "prepare": "husky",
    "prepare:release": "node ./tools/scripts/prepare-release.js",
    "release": "yarn prepare:release && yarn changeset publish",
    "storybook": "nx run storybook:storybook:network",
    "studio": "nx tauri:dev ethlete-studio",
    "timetrack": "nx tauri:dev timetrack-app",
    "timetrack:build": "nx tauri:build timetrack-app",
    "update-nx": "rm -f migrations.json && yarn dlx nx migrate latest && yarn dlx nx migrate --run-migrations --if-exists",
    "versions:check": "node ./tools/scripts/generate-version.js --all --check && node ./tools/scripts/sync-tauri-version.js --check",
    "versions:sync": "node ./tools/scripts/generate-version.js --all && node ./tools/scripts/sync-tauri-version.js"
  },
  "resolutions": {
    "webpack": "5.101.2"
  },
  "dependencies": {
    "@angular/animations": "22.1.6",
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@changesets/cli": "3.0.3",
    "@date-fns/tz": "1.5.0",
    "@floating-ui/dom": "1.8.0",
    "@tauri-apps/api": "2.11.1",
